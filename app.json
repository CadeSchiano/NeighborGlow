{
  "expo": {
    "name": "NeighborGlow",
    "slug": "NeighborGlow",
    "scheme": "neighborglow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/neighborglow-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.cadeschiano.neighborglow",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NeighborGlow uses your location only to center maps or prefill a house listing you choose to publish. It is not shared or stored unless you save your own listing."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0C2D",
          "image": "./assets/neighborglow-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
