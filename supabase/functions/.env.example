# Server-only values for `supabase functions serve` and production Edge Function secrets.
# Do not place any of these values in the Expo app .env file or commit a populated .env file.
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer replace-with-a-long-random-value
REVENUECAT_WEBHOOK_SIGNING_SECRET=replace-with-revenuecat-hmac-signing-secret
REVENUECAT_SECRET_API_KEY=replace-with-revenuecat-secret-api-key
