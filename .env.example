# Only values safe to ship in the mobile app may use the EXPO_PUBLIC_ prefix.
# Never put service-role keys, database passwords, or other secrets in this file.

# Find these in the Supabase project Connect dialog after creating the project.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
